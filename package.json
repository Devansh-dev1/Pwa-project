{
  "name": "testpwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:s3": "aws s3 sync dist/ s3://mobilewebside --delete --exclude 'index.html' --cache-control 'public, max-age=31536000, immutable' && aws s3 cp dist/index.html s3://mobilewebside/index.html --cache-control 'no-cache'",

     "deploy:cf": "aws cloudfront create-invalidation --distribution-id YOUR_DISTRIBUTION_ID --paths '/index.html'",

  "deploy": "npm run build && npm run deploy:s3"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "firebase": "^12.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-mobile-picker": "1.2.0",
    "react-router-dom": "^7.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
